{
  "name": "openvista",
  "version": "1.0.0",
  "description": "OpenVista AI - Real Estate Analysis Platform",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build",
    "start": "node server.js",
    "test": "node ace test",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "setup:db": "node scripts/setup/database.js",
    "db:migrate": "npm run db:migrate -w packages/database",
    "ingest:tiger": "node scripts/data/ingest-tiger.js",
    "ingest:usgs": "node scripts/data/ingest-usgs.js",
    "ingest:osm": "node scripts/data/ingest-osm.js",
    "test:db": "node scripts/setup/test-db.js"
  },
  "dependencies": {
    "@adonisjs/core": "^6.6.0",
    "@adonisjs/lucid": "^20.5.1",
    "@adonisjs/auth": "^9.2.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0",
    "pg": "^8.11.3",
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.4.2",
    "@types/pg": "^8.11.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT"
}
